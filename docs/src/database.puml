' ========================
' Relaciones Globales
' ========================
Caracteristicas ||--|| Mis_Caracteristicas_Relaciones
' Usuarios ||--o{ Observacion
' Mis_Situaciones ||--o{ Estadisticas_Situacion
' Mis_Charlas ||--o{ Estadisticas_Charla
' Mis_Dialogos ||--o{ Estadisticas_Dialogo
Usuarios ||--o{ Estadisticas_Usuario
' Usuarios ||--o{ Tip

@enduml
