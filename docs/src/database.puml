@startuml NeuroPuentes

!include style/cielo-nebuloso.puml/
skinparam backgroundColor transparent

title NeuroPuentes



' ========================
' ZONA PERSONAL
' ========================
package "Personal" {
    
    entity ENUM_TIPO_USUARIO <<enumEntity>>{
        Estudiante
        Supervisor
        Admin
    }

    entity Usuarios {
        +_id : INT NOT NULL
        +nombre_usuario : string
        +nombre : string
        +email : string
        +password_hash : string
        +rol : ENUM
        +estado_cuenta : bool
        +fecha_registro : datetime
    }

    entity Mis_Situaciones {
        +_id : INT NOT NULL
        +id_usuario : INT NOT NULL
        +id_Mis_Contextos : INT NOT NULL
        --
        +estado : bool
        +numero_charlas : int
        +fecha_ultima_charla : datetime
        +progreso : float
    }

    entity Mis_Contextos{
        +_id : INT NOT NULL
        --
        +nombre : VARCHAR (31)
        +descripcion : VARCHAR (255)
    }

    entity Mis_Personajes {
        +_id : INT NOT NULL
        --
        +nombre : varchar(31)
        +descripcion : varchar(255)
        +rol_custom : string
    }

    entity Mis_Caracteristicas_Relaciones <<intermedias>>{
        +id_Caracteristica : INT NOT NULL
        +tipo_objetivo : ENUM
        +id_objetivo : INT NOT NULL
    }

    entity Mis_Charlas{
        +_id : INT NOT NULL
        +id_Mis_Situaciones : INT NOT NULL
        --
        +estado : bool
        +duracion : float
        +numero_turnos : int
    }

    entity Mis_Dialogos {
        +_id : INT NOT NULL
        +id_Mis_Charlas : INT NOT NULL
        +id_Personaje : INT NOT NULL
        --
        +texto : text
        +texto_procesado : text
        +timestamp : datetime
        +es_usuario : bool
        +audio_id : string
    }

    ' === Relaciones de ENUMS ===
    Usuarios }o--|| ENUM_TIPO_USUARIO : "usa"

    ' Relaciones internas
    Mis_Contextos ||--|| Mis_Caracteristicas_Relaciones
    Mis_Personajes ||--|| Mis_Caracteristicas_Relaciones
    Mis_Charlas ||--|| Mis_Caracteristicas_Relaciones
    Mis_Dialogos ||--|| Mis_Caracteristicas_Relaciones

    Mis_Charlas }--|| Mis_Situaciones
    Mis_Dialogos }--|| Mis_Charlas
    Mis_Situaciones ||--|| Mis_Contextos
    Mis_Situaciones }--|| Usuarios
    Mis_Personajes }--|| Mis_Contextos
}



' ========================
' METRICAS Y EVALUACION
' ========================
package estadisticas{

    entity Estadisticas_Usuario {
        _id : int
        usuario_id : int
        --
        fecha : datetime
        situaciones_completadas : int
        tiempo_total : float
        score_global : float
    }

    entity Estadisticas_Situacion {
        _id : int
        --
        situacion_id : int
        usuario_id : int
        --
        fecha : datetime
        progreso : float
        charlas_completadas : int
        tiempo_total : float
    }

    entity Estadisticas_Charla {
        _id : int
        id_charla : int
        id_usuario : int
        --
        fecha : datetime
        numero_turnos : int
        tiempo_promedio_respuesta : float
        eficiencia : float
    }

    entity Estadisticas_Dialogo {
        _id : int
        id_dialogo : int
        id_usuario : int
        --
        fecha : datetime
        longitud_texto : int
        claridad : float
        empatia : float
    }

    entity Tip {
        _id : int
        id_usuario : int
        --
        titulo : string
        contenido : text
        fecha : datetime
        usado : bool
    }
}



' ========================
' ZONA GLOBAL (Seeds)
' ========================
package "Global" {

    entity ENUM_GRUPO_CARACTERISTICA <<enumEntity>>{
        --
        Contexto
        --
        Dificultad
        Situacion_Personaje
        Situacion_Contexto
        Situacion_Charla
        --
        Desempeno
        --
        Epico
        Positivo
        Neutral
        Negativo
    }

    entity ENUM_OBJETIVO_CARACTERISTICA <<enumEntity>>{
        Contexto
        Personaje
        Charla
        Dialogo
        --
        Estadisticas_Usuario
        Estadisticas_Situacion
        Estadisticas_Charla
        Estadisticas_Dialogo
    }

    entity Contextos{
        +_id : INT NOT NULL
        --
        +nombre : VARCHAR (31)
        +descripcion : VARCHAR (255)
    }

    entity Personajes {
        +_id : INT NOT NULL
        --
        +nombre : varchar(31)
        +descripcion : varchar(255)
        +rol_custom : string
    }

    entity Caracteristicas_Relaciones <<intermedias>>{
        +id_caracteristica : INT NOT NULL
        +tipo_objetivo : ENUM
        +id_objetivo : INT NOT NULL
    }

    entity Caracteristicas{
        +_id : INT NOT NULL
        --
        +nombre : varchar(31)
        +descripcion : varchar(255)
        +grupo_caracteristica : ENUM
        +vigencia : boolean
    }

    ' Relaciones dinámicas internas
    Contextos ||--|| Caracteristicas_Relaciones
    Caracteristicas ||--|| Caracteristicas_Relaciones
    Personajes ||--|| Caracteristicas_Relaciones
    Personajes }--|| Contextos

    ' === Relaciones de ENUMS ===
    Caracteristicas }o--|| ENUM_GRUPO_CARACTERISTICA : "usa"
    Caracteristicas_Relaciones }o--|| ENUM_OBJETIVO_CARACTERISTICA : "usa"
}



